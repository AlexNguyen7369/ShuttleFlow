# Copy to .env (never committed) and choose your own values.
DB_USERNAME=shuttleflow
DB_PASSWORD=change-me
# Free key from https://aistudio.google.com/apikey (leave as is to run without AI).
GEMINI_API_KEY=replace-me
# Signs login tokens. Empty = a random secret per start (sign-ins reset on restart).
# For a stable secret, use 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=
